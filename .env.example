# Copie para .env.production (ou .env.local para testar) e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API). A chave "anon" é pública por natureza — a segurança vem das regras do banco.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-aqui
